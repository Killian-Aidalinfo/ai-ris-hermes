# Copie ce fichier dans data/.env puis remplis les valeurs.
# Ne publie jamais data/.env : il contient tes secrets.

# Clé de l'API du gateway (port 8642). Génère-la avec : openssl rand -hex 32
API_SERVER_KEY=

# Discord (facultatif) : jeton du bot et ID Discord des utilisateurs autorisés, séparés par des virgules
DISCORD_BOT_TOKEN=
DISCORD_ALLOWED_USERS=

# Connexion au workspace web (port 9120). Voir le README pour générer ces valeurs.
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=admin
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD_HASH=
HERMES_DASHBOARD_BASIC_AUTH_SECRET=
